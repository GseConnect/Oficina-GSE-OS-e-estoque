rules_version = '2';

// Regras para o PROTÓTIPO.
// Liberam leitura e escrita só nas coleções que começam com "oficina_" e só até 30/11/2026.
// Antes de usar com dados reais, troque por regras com login (Firebase Authentication).
//
// ATENÇÃO: se o protótipo usar o mesmo projeto do GSE Connect, NÃO publique este arquivo inteiro,
// porque ele substituiria as regras que já existem. Copie só o bloco "match /{colecao}/{documento}"
// para dentro das regras atuais pelo Console do Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{colecao}/{documento} {
      allow read, write: if colecao.matches('oficina_.*')
                         && request.time < timestamp.date(2026, 11, 30);
    }
  }
}
