# Copie este arquivo para ".env.local" e preencha com a configuração do app Web do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK > Config).
# Sem esses dados o app abre em "Modo demonstração" e guarda tudo só no navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Prefixo das coleções no Firestore. Evita misturar com coleções que já existem no projeto (como as do GSE Connect).
VITE_COLLECTION_PREFIX=oficina_
