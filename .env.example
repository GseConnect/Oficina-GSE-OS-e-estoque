# Copie este arquivo para ".env.local" e preencha.
# Sem nenhuma configuração o app abre em "Modo demonstração" e guarda tudo só no navegador.

# ---- Opção 1 (recomendada): Supabase ----
# Supabase > Project Settings > API (ou o botão Connect, no topo do painel).
# Use a chave "anon" / "publishable". NUNCA use a "service_role".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Opção 2: Firebase (só vale se as duas linhas acima ficarem vazias) ----
# Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK > Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Prefixo das coleções no Firestore (só Firebase). Evita misturar com coleções que já existem no projeto.
VITE_COLLECTION_PREFIX=oficina_
